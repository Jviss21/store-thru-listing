# Shared pilot password (all seeded users). Server-side only.
DEMO_PASSWORD=testgoodwill

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Prisma — local SQLite (zero-config). For Postgres use:
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?sslmode=require
# and change prisma/schema.prisma datasource provider to "postgresql"
DATABASE_URL="file:./dev.db"

# Optional: set the same vars in Vercel Production / Preview.
# Auth works on Vercel without DATABASE_URL (seed-module fallback).
# Do NOT prefix secrets with NEXT_PUBLIC_.
