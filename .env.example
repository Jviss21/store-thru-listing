# Copy to .env.local for local dev. Never commit real secrets.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# On GCP (future): Secret Manager → Cloud Run env — see docs/GCP-MIGRATION.md.

# --- Auth (required in production) ---
NEXTAUTH_URL=http://localhost:3000
# Cloud Run / custom domain: set to the canonical public URL (https://…)
NEXTAUTH_SECRET=replace-with-a-long-random-string
DEMO_PASSWORD=testgoodwill

# --- Postgres (required for invites, durable products, org settings) ---
# Neon (current prod): pooled + direct URLs from the Neon console / Vercel integration.
# Cloud SQL (future option): use the Cloud SQL connection string or Auth Proxy URL, e.g.
#   postgresql://USER:PASSWORD@127.0.0.1:5432/stl?host=/cloudsql/PROJECT:REGION:INSTANCE
#   or the public IP / private IP URL with sslmode as required.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Invite / transactional email (Resend recommended; stays the same on GCP) ---
# Without these, invites still create a copyable link; UI shows "Email not sent".
RESEND_API_KEY=
# Verified sender in Resend, e.g. "Hammoq <invites@yourdomain.com>"
# Dev fallback: "Store thru Listing <onboarding@resend.dev>" (Resend test domain)
EMAIL_FROM=

# Optional SMTP instead of Resend (requires: npm i nodemailer && @types/nodemailer)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Photos ---
# Vercel today: Blob token (optional locally).
# BLOB_READ_WRITE_TOKEN=
# GCP later: Cloud Storage bucket (wire via photo-storage + service account / ADC).
# GCS_BUCKET=
# GOOGLE_CLOUD_PROJECT=

# --- Marketplace mode (Phase 2; leave mock for pilot) ---
NEXT_PUBLIC_MARKETPLACE_MODE=mock
# MARKETPLACE_MODE=mock
# SHOPGOODWILL_CLIENT_ID=
# SHOPGOODWILL_CLIENT_SECRET=
# SHOPGOODWILL_API_BASE_URL=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RU_NAME=
# EBAY_ENV=sandbox
