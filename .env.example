# Shared pilot password (all seeded users). Server-side only.
DEMO_PASSWORD=testgoodwill

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Prisma — PostgreSQL (Neon via Vercel Marketplace recommended for prod).
# After Neon is connected: `npx vercel env pull .env.local`
# DATABASE_URL = pooled (app queries); DATABASE_URL_UNPOOLED = direct (migrate / db push).
# If you only have one URL, set both to the same connection string.
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASS@HOST:5432/DB?sslmode=require

# Marketplace adapters — mock (default) | live
# Client + server both read NEXT_PUBLIC_MARKETPLACE_MODE; MARKETPLACE_MODE is server fallback.
NEXT_PUBLIC_MARKETPLACE_MODE=mock
# MARKETPLACE_MODE=mock

# --- Phase 2: ShopGoodwill (optional — live mode returns NOT_CONFIGURED until set) ---
# SHOPGOODWILL_CLIENT_ID=
# SHOPGOODWILL_CLIENT_SECRET=
# SHOPGOODWILL_API_BASE_URL=https://api.shopgoodwill.com

# --- Phase 2: eBay (optional — sandbox or production) ---
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RU_NAME=
# EBAY_ENV=sandbox
# Live taxonomy: with CLIENT_ID+SECRET and NEXT_PUBLIC_MARKETPLACE_MODE=live,
# /api/ebay/category-tree and LiveEbayTaxonomyClient call Commerce Taxonomy
# get_default_category_tree_id + getCategoryTree (EBAY_US). Without keys, the
# bundled tree in src/lib/ebay/us-category-tree.json is used.

# Optional: set the same vars in Vercel Production / Preview.
# Auth works on Vercel without DATABASE_URL (seed-module fallback).
# Do NOT prefix marketplace secrets with NEXT_PUBLIC_.

# --- Durable photos (optional) ---
# Vercel Blob — when set, /api/photos/upload stores to Blob CDN.
# Without it: local .data/photos (dev) or in-memory/data-URL fallback.
# BLOB_READ_WRITE_TOKEN=
# TODO: Neon Photo.storageKey + photosJson remain the DB index of URLs.

# --- Shipping labels / EasyPost (optional) ---
# When set, POST /api/shipping/labels tries live EasyPost buy.
# Without it: printable SVG + PDF stub + tracking number (demo).
# EASYPOST_API_KEY=
# Optional ship-from override for live EasyPost:
# EASYPOST_FROM_STREET1=417 Montgomery St
# EASYPOST_FROM_CITY=San Francisco
# EASYPOST_FROM_STATE=CA
# EASYPOST_FROM_ZIP=94104
