# Copy to .env.local for local dev. Never commit real secrets.
# On Vercel: Project ? Settings ? Environment Variables (Production + Preview).
# On GCP (future): Secret Manager ? Cloud Run env ? see docs/GCP-MIGRATION.md.

# --- Auth (required in production) ---
NEXTAUTH_URL=http://localhost:3000
# Cloud Run / custom domain: set to the canonical public URL (https://?)
NEXTAUTH_SECRET=replace-with-a-long-random-string
DEMO_PASSWORD=testgoodwill

# --- Postgres (required for invites, durable products, org settings) ---
# Neon (current prod): pooled + direct URLs from the Neon console / Vercel integration.
# Cloud SQL (future option): use the Cloud SQL connection string or Auth Proxy URL, e.g.
#   postgresql://USER:PASSWORD@127.0.0.1:5432/stl?host=/cloudsql/PROJECT:REGION:INSTANCE
#   or the public IP / private IP URL with sslmode as required.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Invite / transactional email (Resend recommended; stays the same on GCP) ---
# Without these, invites still create a copyable link; UI shows "Email not sent".
RESEND_API_KEY=
# Verified sender in Resend, e.g. "Hammoq <invites@yourdomain.com>"
# Dev fallback: "Store thru Listing <onboarding@resend.dev>" (Resend test domain)
EMAIL_FROM=

# Optional SMTP instead of Resend (requires: npm i nodemailer && @types/nodemailer)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Photos ---
# Vercel today: Blob token (optional locally).
# BLOB_READ_WRITE_TOKEN=
#
# Google Cloud Storage (preferred when set ? see deploy/gcp/ and docs/GCP-MIGRATION.md).
# After signup: create project + bucket (or run deploy/gcp/bootstrap.ps1), then fill:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCP_REGION=us-central1
# GCS_BUCKET=your-photos-bucket
# Public object URLs (default). Set to false for private buckets.
# GCS_PUBLIC_READ=true
# Optional CDN / custom host (no trailing slash):
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-photos-bucket
#
# Auth ? pick ONE (Cloud Run uses ADC automatically; no key needed there):
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\gcp-sa.json
# Or paste the full service-account JSON as a single line (Vercel / .env.local):
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"?",?}

# --- Hammoq Backend (sibling hammoq-backend, port 3001) ---
# Leave unset to keep same-origin /api/* (safe for current Vercel IMS).
# When set, clients should prefer {API_BASE_URL}/api/v1/* for domain data.
# API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Marketplace mode (Phase 2; leave mock for pilot) ---
NEXT_PUBLIC_MARKETPLACE_MODE=mock
# MARKETPLACE_MODE=mock
# SHOPGOODWILL_CLIENT_ID=
# SHOPGOODWILL_CLIENT_SECRET=
# SHOPGOODWILL_API_BASE_URL=
# --- Real eBay (Sell Inventory + OAuth) ? when ALL four are set, Fake eBay is skipped ---
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RU_NAME=
# EBAY_ENV=sandbox
# Optional user refresh token for server-side Inventory without interactive OAuth (dev):
# EBAY_USER_REFRESH_TOKEN=
# Business policies (or leave blank to pick first Account API policy):
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_DEFAULT_CATEGORY_ID=37908
# EBAY_MERCHANT_LOCATION_KEY=default
# EBAY_MERCHANT_POSTAL_CODE=95125
# EBAY_MERCHANT_COUNTRY=US
# Notification / account-deletion challenge token + optional fixed endpoint URLs:
# EBAY_NOTIFICATION_VERIFICATION_TOKEN=
# EBAY_ACCOUNT_DELETION_ENDPOINT=https://your-host/api/marketplaces/ebay/account-deletion
# EBAY_NOTIFICATIONS_ENDPOINT=https://your-host/api/marketplaces/ebay/notifications

# --- Fake eBay = Hammoq Market channel (stand-in until real EBAY_* keys) ---
# Production Market: https://web-rose-two-83.vercel.app (alias https://web-hammoq.vercel.app)
# Local Market: http://localhost:3002
FAKE_EBAY_API_URL=https://web-rose-two-83.vercel.app
FAKE_EBAY_API_KEY=hmq_demo_testgoodwill_west_devkey
# Optional aliases:
# MARKETPLACE_CHANNEL_URL=https://web-rose-two-83.vercel.app
# MARKETPLACE_CHANNEL_API_KEY=hmq_demo_testgoodwill_west_devkey
# FAKE_EBAY_STORE_SLUG=test-goodwill-west
